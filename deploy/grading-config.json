{
  "project": "cra-vulnerability-service",
  "region": "us-central1",
  "coverage_secret": "cra-grading-coverage-token",
  "coverage_secret_version": "1",
  "resources": {
    "cpu": "1", "memory": "1Gi", "timeout": "900", "port": "8080",
    "max": "1", "max-instances": "1", "min": "0", "min-instances": "0",
    "execution-environment": "gen2"
  },
  "system": {
    "service": "cra-phase3-api",
    "repository": "us-central1-docker.pkg.dev/cra-vulnerability-service/cra-phase3/cra-api-grading",
    "concurrency": "8",
    "command": "python",
    "args": "-m,autograder.grading_server",
    "environment": {
      "AUTOGRADER_ENABLED": "true",
      "AUTOGRADER_ALLOW_RESET": "true",
      "AUTOGRADER_DEFAULT_TARGET": "http://127.0.0.1:8080",
      "AUTOGRADER_APPROVED_TARGETS": "http://127.0.0.1:8080",
      "AUTOGRADER_RESET_DATABASE": "cra_grading",
      "AUTOGRADER_RUN_TIMEOUT_SECONDS": "600",
      "AUTOGRADER_COVERAGE_ENABLED": "true",
      "AUTOGRADER_COVERAGE_TARGETS": "http://127.0.0.1:8080",
      "VULNERABILITY_SOURCE": "fixture",
      "VULNERABILITY_TEST_MODE": "true",
      "VULNERABILITY_TEST_DATABASE": "cra_grading"
    }
  },
  "tester": {
    "service": "cra-phase3-tester",
    "repository": "us-central1-docker.pkg.dev/cra-vulnerability-service/cra-phase3/cra-tester",
    "concurrency": "4",
    "command": "uvicorn",
    "args": "app:app,--host,0.0.0.0,--port,8080,--timeout-graceful-shutdown,5",
    "environment": {
      "AUTOGRADER_ENABLED": "true",
      "AUTOGRADER_ALLOW_RESET": "true",
      "AUTOGRADER_DEFAULT_TARGET": "https://cra-phase3-api-456725640364.us-central1.run.app",
      "AUTOGRADER_APPROVED_TARGETS": "https://cra-phase3-api-456725640364.us-central1.run.app",
      "AUTOGRADER_RUN_TIMEOUT_SECONDS": "600",
      "AUTOGRADER_COVERAGE_ENABLED": "true",
      "AUTOGRADER_COVERAGE_TARGETS": "https://cra-phase3-api-456725640364.us-central1.run.app"
    }
  }
}
