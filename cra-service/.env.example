POSTGRES_USER=cra_user
POSTGRES_DB=cra_db
POSTGRES_PASSWORD=replace_with_your_local_database_password
# For an existing volume, use its CURRENT password; this does not rotate it.
# If the password needs URL encoding, set DATABASE_URL explicitly as well.
# DATABASE_URL=postgresql://cra_user:URL_ENCODED_PASSWORD@db:5432/cra_db
DB_STARTUP_ATTEMPTS=30
