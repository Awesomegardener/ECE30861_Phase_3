# Normalize implementation files only; shared contract/fixtures stay untouched.
cra-service/*.py text eol=lf
cra-service/Dockerfile text eol=lf
cra-service/docker-compose*.yml text eol=lf
cra-service/requirements*.txt text eol=lf
scripts/*.py text eol=lf
.github/workflows/*.yml text eol=lf
README.md text eol=lf

# Preserve the pinned upstream OSV schema checksum on Windows and Linux.
cra-service/vendor/osv/schema.json text eol=lf
cra-service/vendor/osv/SOURCE.json text eol=lf
cra-service/vendor/osv/LICENSE text eol=lf
